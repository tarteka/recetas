{
    "name": "tarteka/recetas-api",
    "description": "API REST del proyecto Recetario",
    "license": "proprietary",
    "require": {
        "slim/slim": "^4.0",
        "slim/psr7": "^1.7",
        "google/apiclient": "^2.19"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=256M"
    }
}
