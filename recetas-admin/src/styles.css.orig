*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-width: 0;
  min-height: 100%;
  margin: 0;
  overflow-x: hidden;
}

body {
  background: #f7f5f0;
}

.login-admin {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  width: 100%;
  min-width: 0;
  color: #25251f;
  background: radial-gradient(circle at top, #e7efe8, #f7f5f0 55%);
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

.login-admin__tarjeta {
  width: min(100%, 420px);
  max-width: 100%;
  min-width: 0;
  padding: clamp(24px, 6vw, 48px);
  border: 1px solid #dedbd1;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 20px 55px rgb(38 45 35 / 12%);
  text-align: center;
}

.login-admin__ceja {
  margin: 0 0 12px;
  color: #356044;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.login-admin h1 {
  margin: 0 0 16px;
  max-width: 100%;
  font-family: Georgia, serif;
  font-size: clamp(1.25rem, 7vw, 3rem);
  line-height: 1.05;
  white-space: nowrap;
}

.login-admin__tarjeta > p:not(.login-admin__ceja, .login-admin__error) {
  margin: 0 0 26px;
  color: #6c6b62;
  line-height: 1.6;
}

.login-admin__error {
  padding: 12px;
  border-radius: 10px;
  color: #842a2a;
  background: #fae8e8;
}

.login-admin button {
  width: 100%;
  max-width: 100%;
  min-height: 48px;
  border: 0;
  border-radius: 999px;
  color: #fff;
  background: #356044;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.login-admin button:hover {
  background: #294c35;
}

@media (max-width: 360px) {
  .login-admin {
    padding: 16px;
  }

  .login-admin__tarjeta {
    padding: 24px 18px;
    border-radius: 18px;
  }
}
