# Dominio público utilizado por Caddy para activar HTTPS automático.
RECETAS_DOMINIO=recetas.proyectozero.org

# Token utilizado para autenticar las operaciones de escritura.
RECETAS_API_TOKEN=

# Credenciales OAuth 2.0 de tipo "Aplicación web" creadas en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails administradores separados por coma y secreto aleatorio de 32+ caracteres.
ADMIN_ALLOWED_EMAILS=semosa@gmail.com
ADMIN_SESSION_SECRET=

# Desarrollo: http://localhost:5174/api/admin/auth/google/callback
# Producción: https://recetas.proyectozero.org/api/admin/auth/google/callback
ADMIN_GOOGLE_REDIRECT_URI=

# Orígenes autorizados para peticiones administrativas mutables, separados por coma.
ADMIN_ALLOWED_ORIGINS=
